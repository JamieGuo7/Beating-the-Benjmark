import pandas as pd
import numpy as np
import yfinance as yf
import os

def calculate_rsi(ticker_symbol: str, period: int = 14) -> float:
    """Calculates the 14-day RSI for a given ticker."""
    try:
        stock = yf.Ticker(ticker_symbol)
        hist = stock.history(period="3mo")
        if hist.empty or len(hist) < period + 1:
            return np.nan
        delta = hist['Close'].diff()
        gain = delta.where(delta > 0, 0)
        loss = -delta.where(delta < 0, 0)
        avg_gain = gain.ewm(alpha=1/period, adjust=False).mean()
        avg_loss = loss.ewm(alpha=1/period, adjust=False).mean()
        rs = avg_gain / avg_loss
        rsi = 100 - (100 / (1 + rs))
        return rsi.iloc[-1]
    except Exception:
        return np.nan

def add_momentum_to_ratios(ratios_file_path: str, output_file_path: str):
    """
    Reads an existing ratios CSV file, calculates RSI for each ticker, 
    and updates the total score.
    """
    print(f"Reading existing key ratios from {ratios_file_path}...")
    
    if not os.path.exists(ratios_file_path):
        print(f"Error: Could not find {ratios_file_path}")
        print("Please check that the file name matches your previously generated data.")
        return
        
    # Read the existing ratios data
    try:
        df = pd.read_csv(ratios_file_path)
    except Exception as e:
        print(f"Error reading file: {e}")
        return
        
    if 'Ticker' not in df.columns:
        print("Error: The file must contain a 'Ticker' column.")
        return
        
    tickers = df['Ticker'].unique().tolist()
    print(f"Found {len(tickers)} tickers. Calculating RSI momentum...")
    
    # Dictionary to hold RSI values
    rsi_data = []
    
    for ticker in tickers:
        rsi_val = calculate_rsi(ticker)
        rsi_data.append({'Ticker': ticker, 'RSI_14d': rsi_val})
        
    # Convert RSI data to DataFrame and merge with the existing ratios
    df_rsi = pd.DataFrame(rsi_data)
    df = df.merge(df_rsi, on='Ticker', how='left')
    
    # Evaluate Momentum
    df['Good_Momentum'] = df.apply(
        lambda row: 'Yes' if pd.notna(row['RSI_14d']) and (50 <= row['RSI_14d'] <= 70) 
        else ('No' if pd.notna(row['RSI_14d']) else 'N/A'), 
        axis=1
    )
    
    # Update Total_Metrics_Beaten if the fundamental columns exist
    fundamental_cols = ['Beats_Ind_PE', 'Beats_Ind_PB', 'Beats_Ind_ROE', 'Beats_Ind_Debt']
    existing_cols = [col for col in fundamental_cols if col in df.columns]
    
    # Add 'Good_Momentum' to the list of columns to score
    score_cols = existing_cols + ['Good_Momentum']
    
    df['Total_Metrics_Beaten'] = df[score_cols].apply(
        lambda x: (x == 'Yes').sum(), axis=1
    )
    
    # Save the updated file
    os.makedirs(os.path.dirname(output_file_path), exist_ok=True)
    df.to_csv(output_file_path, index=False)
    print(f"Success! Momentum data added. Saved to {output_file_path}")
    
    return df

