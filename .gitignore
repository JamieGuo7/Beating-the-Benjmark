# Model Training Runs. The bulk is regenerable and large (~500MB of .keras,
# .joblib and .png), but the *record* a run leaves behind - per-ticker metrics,
# forecasts and backtest results - is small and is the provenance trail
# ADR-0001 exists to protect. So: ignore the run contents, keep the record.
/runs/**
!/runs/*/
!/runs/*.csv
!/runs/*.json
!/runs/*/manifest.json
!/runs/*/results.csv
!/runs/*/forecasts.csv
!/runs/*/backtests/
!/runs/*/backtests/**

# The oversized raw price files (>200MB each, would fail a push).
# Everything else under data/ stays tracked as it was.
/data/raw/prices/esgu_ohlcv_daily.csv
/data/raw/prices/esgu_ohlcv_daily.backup.csv
/data/raw/prices/esgu_historical_2014_2026.csv

# Test artefacts. tests/test_ticker_trainer.py trains a real model into these,
# relative to the working directory, so running pytest from the repo root
# leaves a .keras, a .joblib and a plot behind every time.
/.tmp_models/
/.tmp_plots/

__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.idea/
.DS_Store
folder_tree.txt
/scratch

# Aaron's ratio analysis lives on the aaron-key-ratios branch, not main.
/Key ratios and momentums/
